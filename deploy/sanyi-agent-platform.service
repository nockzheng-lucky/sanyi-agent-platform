[Unit]
Description=Sanyi Agent Platform (factor chat + signal push)
After=network.target
# 门信号文件由 sanyi-futures-green-engine 写；本服务只读，不要求强顺序。
# 如果希望门引擎先起来，再加 After=sanyi-futures-green-engine.service。

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/sanyi-agent-platform
EnvironmentFile=/home/ubuntu/sanyi-agent-platform/.env
ExecStart=/home/ubuntu/sanyi-agent-platform/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8100
Restart=on-failure
RestartSec=3

# 基础加固（候选版，上线前由部署 Owner 审阅）
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/ubuntu/sanyi-agent-platform/data
ProtectHome=read-only
# 门信号只读路径已包含在 ProtectHome=read-only 中

[Install]
WantedBy=multi-user.target
