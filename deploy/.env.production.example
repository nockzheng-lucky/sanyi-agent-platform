# 101 生产机示例。复制为 /home/ubuntu/sanyi-agent-platform/.env 后填写。
# 平台目录独立于 /home/ubuntu/projects/sanyi*。

SANYI_DATA_DIR=/home/ubuntu/sanyi-agent-platform/data
SANYI_ENABLE_TOKEN_ISSUE_API=false
SANYI_ADMIN_KEY=

# DeepSeek（key 由 Owner 单独填入）
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_MOCK=0

# 只读 sanyi-green 的门信号文件
SANYI_GATE_REGISTRY_FILE=/home/ubuntu/projects/sanyi-green/runtime/state/gate_registry.json
SANYI_SIGNAL_POLL_ENABLED=true
SANYI_SIGNAL_POLL_SECONDS=30
SANYI_TRADING_SESSIONS=09:00-11:30,13:00-15:00,21:00-02:30

# 安全
SANYI_COOKIE_SECURE=true
SANYI_TOKEN_RATE_LIMIT_PER_MIN=60
SANYI_CHAT_MAX_TOOL_ROUNDS=6
SANYI_CHAT_MAX_MESSAGES=20
