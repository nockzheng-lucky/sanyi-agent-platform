# ===== 平台 =====
SANYI_DATA_DIR=./data
SANYI_ENABLE_TOKEN_ISSUE_API=false
SANYI_ADMIN_KEY=
# 手机号 HMAC 密钥；不填则首次启动自动生成 data/phone_secret（600）
SANYI_PHONE_HASH_SECRET=
# 短信验证码：true=本地 MOCK（返回 debugCode）；接真实短信后改 false
SANYI_SMS_MOCK=true
# 订阅门槛：false=不拦截；接支付后改 true
SANYI_SUBSCRIPTION_REQUIRED=false

# ===== 页面 Agent 的 LLM（平台承担成本）=====
# 模型名以供应商给出的精确字符串为准；base_url 随供应商切换。
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
# LLM_MOCK=1 时用本地假模型跑通链路，不产生成本。
LLM_MOCK=0

# ===== 门信号读取（只读，不消耗 LLM token，也不扣平台额度）=====
# 本地联调：/Users/gaomengyuan/dev/sanyi/apps/futures/gate_events.sqlite3
# 101 生产机：/home/ubuntu/projects/sanyi-green/runtime/state/gate_events.sqlite3
SANYI_GATE_EVENTS_DB=/Users/gaomengyuan/dev/sanyi/apps/futures/gate_events.sqlite3
SANYI_SIGNAL_POLL_ENABLED=true
SANYI_SIGNAL_POLL_SECONDS=30
SANYI_SIGNAL_SUBSCRIPTION_POLL_SECONDS=30
# 覆盖全品种：白天到 11:30、下午从 13:00 起，夜盘跨零点到 02:30
SANYI_TRADING_SESSIONS=09:00-11:30,13:00-15:00,21:00-02:30

# ===== 诀与破诀因子（只读 HTTP）=====
SANYI_JUE_DIRECTION_URL=https://qh.shhghf.com/api/market/jue-direction
SANYI_JUE_DIRECTION_TIMEOUT_SECONDS=10

# ===== 币圈诀与破诀因子（影子模式专用）=====
# 东京币圈服务器：sanyi-bybit-tokyo-01（167.179.69.189）
SANYI_CRYPTO_JUE_DIRECTION_URL=https://167.179.69.189/api/market/jue-direction
# 该服务器证书不匹配 IP；上线有效域名证书后可改为 true
SANYI_CRYPTO_VERIFY_SSL=false
SANYI_CRYPTO_TIMEOUT_SECONDS=10

# ===== Pushplus 推送 =====
# token 未配置时不启动推送 worker；推送内容按订阅动态生成。
SANYI_PUSHPLUS_ENABLED=true
SANYI_PUSHPLUS_TOKEN=
SANYI_PUSHPLUS_URL=https://www.pushplus.plus/send
SANYI_SIGNAL_SUBSCRIPTION_PUSH_SECONDS=60

# ===== 安全 =====
# 生产 HTTPS 后必须 SANYI_COOKIE_SECURE=true；本地 http 保持 false
SANYI_COOKIE_SECURE=false
SANYI_TOKEN_RATE_LIMIT_PER_MIN=60
SANYI_CHAT_MAX_TOOL_ROUNDS=6
SANYI_CHAT_MAX_MESSAGES=20
