# ===== 平台 =====
SANYI_DATA_DIR=./data
SANYI_ENABLE_TOKEN_ISSUE_API=false
SANYI_ADMIN_KEY=

# ===== 页面 Agent 的 LLM（平台承担成本）=====
# OpenAI 兼容接口；也可以指向任意中转网关。
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
# LLM_MOCK=1 时用本地假模型跑通链路，不产生成本。
LLM_MOCK=0

# ===== 安全 =====
SANYI_TOKEN_RATE_LIMIT_PER_MIN=60
SANYI_CHAT_MAX_TOOL_ROUNDS=6
SANYI_CHAT_MAX_MESSAGES=20

# ===== 因子占位开关（接入三易引擎后去掉）=====
FACTOR_DIMEN_GATE_MOCK=1
