# ===== 平台 =====
SANYI_DATA_DIR=./data
SANYI_ENABLE_TOKEN_ISSUE_API=false
SANYI_ADMIN_KEY=

# ===== 页面 Agent 的 LLM（平台承担成本）=====
# DeepSeek 官方 OpenAI 兼容接口。如果你说的 flash 是某个中转模型名，
# 直接改 LLM_MODEL 为供应商给出的精确字符串即可。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_MOCK=1 时用本地假模型跑通链路，不产生成本。
LLM_MOCK=0

# ===== 门信号读取（只读 sanyi 引擎的 gate_registry.json）=====
SANYI_GATE_REGISTRY_FILE=/absolute/path/to/sanyi/apps/futures/gate_registry.json
SANYI_SIGNAL_POLL_ENABLED=true
SANYI_SIGNAL_POLL_SECONDS=30
# 交易时段；具体品种夜盘不同，请按实际覆盖
SANYI_TRADING_SESSIONS=09:00-10:15,10:30-11:30,13:30-15:00,21:00-23:00

# ===== 安全 =====
SANYI_TOKEN_RATE_LIMIT_PER_MIN=60
SANYI_CHAT_MAX_TOOL_ROUNDS=6
SANYI_CHAT_MAX_MESSAGES=20
